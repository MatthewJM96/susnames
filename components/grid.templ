package components

import "strconv"
import "github.com/MatthewJM96/susnames/grid"

templ SpymasterCard(card *grid.Card, index int) {
	switch card.Type {
	case grid.CIVILIAN:
		<div id={ "card-" + card.Word } class="card card-civilian">{ card.Word }</div>
	case grid.SPY_TARGET:
		<div id={ "card-" + card.Word } class="card card-spy-target">{ card.Word }</div>
	case grid.COUNTERSPY_TARGET:
		<div id={ "card-" + card.Word } class="card card-counterspy-target">{ card.Word }</div>
	default:
		<div id={ "card-" + card.Word } class="card">{ card.Word }</div>
	}
}

templ spyCardVoteButton(card *grid.Card, index int, sessionID string) {
	if _, exists := card.Votes[sessionID]; exists {
		<button class="card-unvote" ws-send hx-vals={ "{\"cmd\": \"unvote-card\", \"data0\": \"" + strconv.Itoa(index) + "\"}" }>✘</button>
	} else {
		<button class="card-vote" ws-send hx-vals={ "{\"cmd\": \"vote-card\", \"data0\": \"" + strconv.Itoa(index) + "\"}" }>✔</button>
	}
}

templ SpyCard(card *grid.Card, index int, isCounterspy bool, voting bool, sessionID string) {
	if card.Selected {
		@SpymasterCard(card, index)
	} else {
		if isCounterspy && card.Type == grid.COUNTERSPY_TARGET {
			<div id={ "card-" + card.Word } class="card card-counterspy-target">
				{ card.Word }
				if voting {
					@spyCardVoteButton(card, index, sessionID)
				}
			</div>
		} else {
			<div id={ "card-" + card.Word } class="card">
				{ card.Word }
				if voting {
					@spyCardVoteButton(card, index, sessionID)
				}
			</div>
		}
	}
}

templ SpymasterGrid(grid *grid.Grid) {
	<div id="grid">
		for i := range 5 {
			<div class="card-row">
				for j := range 5 {
					@SpymasterCard(grid.Cards[i * 5 + j], i * 5 + j)
				}
			</div>
		}
	</div>
}

templ SpyGrid(grid *grid.Grid, isCounterspy bool, voting bool, sessionID string) {
	<div id="grid">
		for i := range 5 {
			<div class="card-row">
				for j := range 5 {
					@SpyCard(grid.Cards[i * 5 + j], i * 5 + j, isCounterspy, voting, sessionID)
				}
			</div>
		}
	</div>
}
